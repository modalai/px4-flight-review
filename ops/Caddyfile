# Installed on the VM as /etc/caddy/Caddyfile. Caddy terminates TLS (Let's Encrypt,
# automatic renewal) and proxies pages and plots to the flight-review containers on
# ports 5006, 5008 and 5009, and upload POSTs to flight-review-upload on port 5007.
#
# Browsing logs requires a Google sign-in with a modalai.com account. The check is
# done by oauth2-proxy (see start_auth_proxy.sh) on port 4180. Uploading stays open.
# A plot page and its websocket must reach the same server process (the plot
# lives in that process), so each browser sticks to one server via a cookie.
(plot_servers) {
	reverse_proxy 127.0.0.1:5006 127.0.0.1:5008 127.0.0.1:5009 {
		lb_policy cookie fr_server
		fail_duration 10s
	}
}

flight-review.modalai.com {
	encode gzip

	# Keep crawlers off: every plot page renders a full log on the server.
	handle /robots.txt {
		header Content-Type text/plain
		respond "User-agent: *
Disallow: /
"
	}

	# Sign-in, callback and sign-out endpoints of oauth2-proxy.
	handle /oauth2/* {
		reverse_proxy 127.0.0.1:4180 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Upload POSTs go to their own container, so they never queue behind a plot.
	@upload {
		method POST
		path / /upload
	}
	handle @upload {
		reverse_proxy 127.0.0.1:5007
	}

	# Anyone may upload: the landing/upload page, the upload POST, and the
	# static assets those pages need. None of these expose log data.
	@open path / /upload /static/* /plot_app/static/*
	handle @open {
		import plot_servers
	}

	# Everything else (browse, plot pages, download, 3D, edit, stats, thumbnails)
	# needs a valid session cookie; otherwise bounce to Google and come back here.
	handle {
		forward_auth 127.0.0.1:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-Email
			@error status 401
			handle_response @error {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		import plot_servers
	}
}
